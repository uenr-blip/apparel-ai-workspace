# 本地验证默认配置。密钥只放服务端环境，不要写入前端或种子数据。

NODE_ENV=development
APP_NAME=服装 AI 工作台
APP_URL=http://localhost:3100

# 仅本地演示登录。生产环境必须为 false。
DEMO_LOGIN_ENABLED=true
SESSION_SECRET=change-me-to-a-long-random-string-for-local-dev

# SQLite 仅用于本地验证，不是生产并发方案。
DATABASE_URL="file:./prisma/dev.db"

# mock：内置演示提取，界面必须标注未调用真实模型。
# live：必须配置密钥；失败不得静默退回 mock。
# 视觉识款未接通。capabilities 不含 vision 时，图片/扫描 PDF 只保存、不识别、不编 BOM。
AI_MODE=mock
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_CAPABILITIES=text,structured-output
# 图像生成（AI设计工作台）。未齐时界面与接口必须报未配置，不得 mock 成功。
# AI_IMAGE_BASE_URL=
# AI_IMAGE_API_KEY=
# AI_IMAGE_MODEL=

# 演示参考时钟，测试可覆盖。
DEMO_CLOCK=2026-09-18T09:00:00+08:00
DEMO_TIMEZONE=Asia/Shanghai

# 企业级智能体入口：只需填写下一行的百炼北京地域 API Key，然后重启项目。
AGENT_API_KEY=
AGENT_MODE=mock
AGENT_PROVIDER=bailian
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen3.7-plus

# DeepSeek 官方接口：只需填此独立密钥；在智能体弹窗中选择 DeepSeek。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 千问 3.8 Max 共用上面的百炼 AGENT_API_KEY，在弹窗中选择即可。
AI_IMAGE_MODE=mock
AI_IMAGE_PROVIDER=bailian-native
AI_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_IMAGE_MODEL=wan2.7-image-pro
ASR_MODE=mock
ASR_MODEL=qwen3-asr-flash
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
